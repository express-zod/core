{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 320,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false
}
